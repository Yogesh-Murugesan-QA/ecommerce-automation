<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests run in parallel; each thread gets its own browser (ThreadLocal driver) -->
<suite name="E-commerce Automation Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.automation.ecommerce.reports.TestListener"/>
    </listeners>
    <test name="E-commerce Tests">
        <!-- All tests are in "regression"; run only the quick "smoke" set with: mvn clean test -Dgroups=smoke -->
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.ecommerce.tests.EndToEndFlowTest"/>
            <class name="com.automation.ecommerce.tests.NegativeTests"/>
            <class name="com.automation.ecommerce.tests.CartAndCheckoutTests"/>
        </classes>
    </test>
</suite>
